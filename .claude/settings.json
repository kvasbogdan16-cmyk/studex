{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/after-plan-dev-server.js"],
            "timeout": 15,
            "statusMessage": "Перевіряю, чи треба перезапустити дев-сервер"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "PowerShell|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/after-deploy-watch.js"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
